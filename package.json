{
  "name": "bottomsheet-dialog-monorepo",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "oxlint",
    "test": "vitest",
    "storybook": "pnpm -F @bottomsheet-dialog/storybook run storybook --host 127.0.0.1 --port 6006",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "oxlint": "latest",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "version": "0.0.1"
}
