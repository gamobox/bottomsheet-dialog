{
  "name": "@bottomsheet-dialog/element",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamobox/bottomsheet-dialog.git",
    "directory": "packages/element"
  },
  "bugs": {
    "url": "https://github.com/gamobox/bottomsheet-dialog/issues"
  },
  "homepage": "https://github.com/gamobox/bottomsheet-dialog#readme",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --dts --minify",
    "dev": "tsup src/index.ts --format esm,cjs,iife --dts --watch",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@bottomsheet-dialog/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
