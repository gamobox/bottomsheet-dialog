{
  "name": "@bottomsheet-dialog/element",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --dts --minify",
    "dev": "tsup src/index.ts --format esm,cjs,iife --dts --watch",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@bottomsheet-dialog/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
